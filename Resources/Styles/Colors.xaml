<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand (overridden at runtime by ThemeService palettes) -->
    <Color x:Key="Primary">#FF7A59</Color>
    <Color x:Key="PrimaryDark">#FF9B82</Color>
    <Color x:Key="PrimaryDarkText">#1C1C1E</Color>
    <Color x:Key="Secondary">#FFE4DC</Color>
    <Color x:Key="SecondaryDarkText">#FF7A59</Color>
    <Color x:Key="Tertiary">#E86545</Color>
    <Color x:Key="AccentSoft">#FFE4DC</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#1C1C1E</Color>

    <Color x:Key="Gray100">#F2F2F7</Color>
    <Color x:Key="Gray200">#E5E5EA</Color>
    <Color x:Key="Gray300">#D1D1D6</Color>
    <Color x:Key="Gray400">#AEAEB2</Color>
    <Color x:Key="Gray500">#8E8E93</Color>
    <Color x:Key="Gray600">#636366</Color>
    <Color x:Key="Gray900">#1C1C1E</Color>
    <Color x:Key="Gray950">#0A0A0A</Color>

    <Color x:Key="Success">#3DAB7E</Color>
    <Color x:Key="SuccessLight">#E8F8F0</Color>
    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="StreakAccent">#FF8A4C</Color>
    <Color x:Key="Danger">#FF5A5F</Color>

    <!-- Soft surfaces -->
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#2C2C2E</Color>
    <Color x:Key="PageLight">#F7F4F1</Color>
    <Color x:Key="PageDark">#0F0F10</Color>
    <Color x:Key="ChipLight">#FFF7F4</Color>
    <Color x:Key="ChipDark">#3A3A3C</Color>
    <Color x:Key="MutedLight">#F0EBE6</Color>
    <Color x:Key="MutedDark">#1C1C1E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
